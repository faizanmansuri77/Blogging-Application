pipeline {
    agent any

    parameters {
        choice(
            name: 'action',
            choices: ['apply', 'destroy'],
            description: 'Terraform action'
        )
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/faizanmansuri77/Blogging-Application.git'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('EKS_Terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Apply/Destroy') {
            steps {
                dir('EKS_Terraform') {
                    sh "terraform ${params.action} --auto-approve"
                }
            }
        }

    }
}
